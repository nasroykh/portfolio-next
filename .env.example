# Public domain without protocol, used for canonical URLs, sitemap, OG images
NEXT_PUBLIC_DOMAIN_NAME=nascodes.dev

# OpenRouter key for the Otacon chat assistant and embeddings
OPENROUTER_API_KEY=sk-or-...

# Qdrant vector store (defaults to http://localhost:6333 without auth)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Bearer token required by POST /api/init-db (endpoint is disabled when unset)
INIT_DB_SECRET=

# Header carrying the real client IP for the chat rate limit, e.g. cf-connecting-ip behind Cloudflare.
# When unset: X-Real-IP, then the right-most X-Forwarded-For hop. Only set it if the origin
# accepts traffic from the CDN alone, otherwise clients can spoof it.
CLIENT_IP_HEADER=
